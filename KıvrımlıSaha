```html
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>3D Kıvrımlı Saha Modeli</title>

  <script type="module"
    src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.4.0/model-viewer.min.js">
  </script>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f1f3f5;
      text-align: center;
    }

    h2 { padding: 12px; }

    model-viewer {
      width: 100%;
      height: 75vh;
      min-height: 400px;
      background: white;
    }

    p { padding: 10px; color: #444; }
  </style>
</head>
<body>
  <h2>3D Kıvrımlı Saha Modeli</h2>

  <model-viewer
    src="./KıvrımlıSaha.glb"
    alt="Etkileşimli 3D kıvrımlı saha modeli"
    camera-controls
    auto-rotate
    shadow-intensity="1"
    exposure="1">
  </model-viewer>

  <p>Modeli döndürmek ve yakınlaştırmak için dokunun
  veya fareyi kullanın.</p>

  <p><a href="./">İlk modele geri dön</a></p>
</body>
</html>
